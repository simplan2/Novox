<Window
    x:Class="Novox.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Novox.App.ViewModels"
    Title="Novox — Clonador de Voz Local"
    Width="1160"
    Height="780"
    MinWidth="960"
    MinHeight="620"
    Background="#0e1117">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#161b24" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="#2a323f" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.item">
            <Setter Property="Background" Value="#0e1117" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="BorderBrush" Value="#2a323f" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="#2a323f" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.pageSub">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#9aa7b6" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9aa7b6" />
        </Style>
        <Style Selector="TextBlock.stepTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#4f8cff" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9aa7b6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.empty">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#9aa7b6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,24" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#e6edf3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#4f8cff" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="#1e2530" />
            <Setter Property="Foreground" Value="#e6edf3" />
            <Setter Property="BorderBrush" Value="#2a323f" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#f85149" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.iconbtn">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.dangerGhost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#f85149" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!--  ═══ Barra lateral ═══  -->
        <Border
            Width="232"
            Padding="16"
            Background="#0b0e13"
            BorderBrush="#2a323f"
            BorderThickness="0,0,1,0"
            DockPanel.Dock="Left">
            <Grid RowDefinitions="Auto,*,Auto">
				
                <StackPanel
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
					<Image Source="/Assets/novox-logo.png" Height="30"/>
                    <!--<TextBlock
                        VerticalAlignment="Center"
                        FontSize="30"
                        Text="🎙️" />-->
                    <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="Novox" />
                        <TextBlock
                            FontSize="10"
                            Foreground="#9aa7b6"
                            Text="Voz local · Qwen3-TTS" />
                    </StackPanel>
                </StackPanel>

                <!--  Flujo  -->
                <Grid
                    Grid.Row="1"
                    Margin="0,28,0,0"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="6">
                    <TextBlock
                        Margin="10,0,0,4"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#5b6675"
                        Text="FLUJO" />

                    <!--  Nemu de flujo  -->
                    <StackPanel Grid.Row="1" Spacing="10">

                        <Button
                            Background="{Binding Tab1Color}"
                            Classes="nav"
                            Command="{Binding SwitchToTab1Command}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="badge">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="1" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Voces" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="#9aa7b6"
                                        Text="Graba o importa" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button
                            Background="{Binding Tab2Color}"
                            Classes="nav"
                            Command="{Binding SwitchToTab2Command}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="badge">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="2" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Sintetizar" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="#9aa7b6"
                                        Text="Texto → audio" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button
                            Background="{Binding Tab3Color}"
                            Classes="nav"
                            Command="{Binding SwitchToTab3Command}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="badge">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="3" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Historial" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="#9aa7b6"
                                        Text="Tus audios" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <TextBlock
                            Margin="10,14,0,4"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#5b6675"
                            Text="SISTEMA" />
                        <Button
                            Background="{Binding Tab4Color}"
                            Classes="nav"
                            Command="{Binding SwitchToTab4Command}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="badge">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="⬇" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Modelos" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="#9aa7b6"
                                        Text="Pesos GGUF" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>


                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock
                        Margin="10,0,0,4"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#5b6675"
                        Text="ESTADO" />
                    <TextBlock
                        Margin="10,0"
                        FontSize="11"
                        Foreground="#9aa7b6"
                        Text="{Binding EstadoTexto}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="10,0"
                        FontSize="10"
                        Foreground="#5b6675"
                        Text="{Binding InfoSistema}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ═══ Contenido ═══  -->
        <Grid>
            <!--  ── Página 1 · Voces ──  -->
            <Grid
                Margin="20"
                IsVisible="{Binding Tab1Visible}"
                RowDefinitions="Auto,*">

                <!--  Título "Voces"  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,16"
                    Spacing="2">
                    <TextBlock Classes="pageTitle" Text="Voces" />
                    <TextBlock Classes="pageSub" Text="Graba o importa una voz una vez y reutilízala en todas tus síntesis." />
                </StackPanel>

                <!--  Contenedor"  -->
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,420"
                    ColumnSpacing="16">

                    <!--  1. Biblioteca  -->
                    <Border
                        Grid.Column="0"
                        Padding="0"
                        Classes="card">
                        <DockPanel>
                            <Grid
                                Margin="20,16,20,0"
                                ColumnDefinitions="*,Auto"
                                DockPanel.Dock="Top">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Classes="cardTitle"
                                    Text="Mis voces" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#9aa7b6">
                                    <Run Text="{Binding Voces.Count}" /><Run Text=" guardadas" />
                                </TextBlock>
                            </Grid>
                            <ScrollViewer Margin="20,8,20,16">
                                <Grid>
                                    <!--  Item de voces  -->
                                    <ItemsControl ItemsSource="{Binding Voces}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="64" Classes="item">
                                                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8">

                                                        <Button
                                                            Grid.Column="0"
                                                            Padding="10,6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            Background="#4f8cff"
                                                            Classes="iconbtn"
                                                            Command="{Binding PlayCommand}"
                                                            CommandParameter="{Binding}"
                                                            Content="▶"
                                                            Foreground="White" />

                                                        <!--  Title Audio  -->
                                                        <Grid
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            RowDefinitions="Auto, Auto"
                                                            RowSpacing="5">
                                                            <TextBlock
                                                                Grid.Row="0"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                Text="{Binding Nombre}"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap" />

                                                            <Grid
                                                                Grid.Row="1"
                                                                ColumnDefinitions="Auto,*"
                                                                ColumnSpacing="6">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="#9aa7b6"
                                                                    Text="{Binding DuracionText}" />

                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="10"
                                                                    Foreground="#5b6675"
                                                                    Text="{Binding Transcripcion}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    TextWrapping="NoWrap" />
                                                            </Grid>
                                                        </Grid>

                                                        <!--  Buttons  -->
                                                        <Grid
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            ColumnDefinitions="Auto, 42">
                                                            <Button
                                                                Padding="10,6"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                Classes="ghost"
                                                                Command="{Binding UseCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="Usar"
                                                                FontSize="11" />


                                                            <Button
                                                                Grid.Column="1"
                                                                Padding="10,6"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                Classes="ghost"
                                                                Command="{Binding DeleteCommand}"
                                                                CommandParameter="{Binding}"
                                                                Content="✕"
                                                                FontSize="11" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!--  Texto Cuando no hay voces  -->
                                    <TextBlock
                                        Classes="empty"
                                        IsVisible="{Binding !HayVoces}"
                                        Text="Aún no tienes voces.&#10;Graba una con el micrófono o importa un archivo →" />
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!--  2. Nueva voz  -->
                    <ScrollViewer Grid.Column="1">
                        <!--  Contenedor  -->
                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="22">

                                <!--  Bloque 1 Grabar Voz  -->
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="cardTitle" Text="Grabar voz" />
                                        <TextBlock Classes="hint" Text="10–15 segundos, una sola persona, sin ruido ni música." />
                                    </StackPanel>
                                    <Grid Margin="0,8" RowDefinitions="Auto,*" RowSpacing="10">
                                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Grid.Row="1">
                                            <!--  Level de audio  -->
                                            <Border
                                                Width="300"
                                                Height="16"
                                                Padding="2" VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Background="#0e1117"
                                                BorderBrush="#2a323f"
                                                BorderThickness="1"
                                                CornerRadius="4">

                                                <!--  Contenedor que actúa como máscara de recorte dinámica  -->
                                                <Border
                                                    Width="{Binding AudioLevelWidth}"
                                                    HorizontalAlignment="Left"
                                                    BorderThickness="0"
                                                    ClipToBounds="True"
                                                    CornerRadius="2">

                                                    <!--
                                                        Este gradiente es TOTALMENTE ESTÁTICO y mide siempre 300px de ancho fijo,
                                                        por lo que NUNCA se encoge ni se deforma; solo se revela.
                                                    -->
                                                    <Border
                                                        Width="300"
                                                        Height="14"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="2">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                <GradientStop Offset="0.0" Color="LimeGreen" />
                                                                <GradientStop Offset="0.6" Color="Gold" />
                                                                <GradientStop Offset="1.0" Color="IndianRed" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>

                                                </Border>
                                            </Border>


                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#4f8cff"
                                                Text="{Binding Cronometro}" />
                                        </Grid>

                                        <Button
                                            Grid.Row="0"
                                            Margin="0,4"
                                            Padding="16,12"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="{Binding GrabarColor}"
                                            Classes="primary"
                                            Command="{Binding GrabarCommand}"
                                            Content="{Binding GrabarTexto}"
                                            FontSize="15" />

                                    </Grid>



                                    <TextBox
                                        FontSize="12"
                                        PlaceholderText="Nombre de la voz (p. ej. «Narrador»)"
                                        Text="{Binding NombreVoz}" />
                                    <TextBox
                                        Height="52"
                                        AcceptsReturn="True"
                                        FontSize="12"
                                        PlaceholderText="Lo que dice el audio (mejora el parecido)"
                                        Text="{Binding TranscripcionVoz}" />
                                    <Button
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Right"
                                        HorizontalContentAlignment="Center"
                                        Classes="primary"
                                        Command="{Binding GuardarVozCommand}"
                                        Content="Agregar a Voces" />
                                </StackPanel>

                                <!--  Bloque 2 Usar archivo de audio  -->
                                <StackPanel Grid.Row="1" Spacing="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="cardTitle" Text="Usar archivo de audio" />
                                        <TextBlock Classes="hint" Text="WAV, MP3, M4A, OGG… se normaliza solo al importar." />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox
                                            Grid.Column="0"
                                            FontSize="11"
                                            PlaceholderText="Ningún archivo elegido…"
                                            Text="{Binding ArchivoSeleccionado}" />
                                        <Button
                                            Grid.Column="1"
                                            Classes="ghost"
                                            Click="ExaminarArchivo_Click"
                                            Content="Examinar…" />
                                    </Grid>
                                    <TextBox
                                        FontSize="12"
                                        PlaceholderText="Nombre de la voz (p. ej. «Narrador»)"
                                        Text="{Binding NombreArchivo}" />
                                    <TextBox
                                        Height="52"
                                        AcceptsReturn="True"
                                        FontSize="12"
                                        PlaceholderText="Lo que dice el audio (mejora el parecido)"
                                        Text="{Binding TranscripcionArchivo}" />
                                    <Button
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Right"
                                        HorizontalContentAlignment="Center"
                                        Classes="primary"
                                        Command="{Binding SubirArchivoCommand}"
                                        Content="Agregar a Voces" />
                                </StackPanel>

                                <!--  Bloque 3 · Consejo  -->
                                <Border
                                    Grid.Row="2"
                                    Padding="12"
                                    VerticalAlignment="Center"
                                    Background="#0e1117"
                                    BorderBrush="#2a323f"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <TextBlock Classes="hint" Text="💡 Para máxima fidelidad: referencia limpia de 10–15 s con su transcripción, y temperatura a 0,6–0,7 en Sintetizar." />
                                </Border>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!--  ── Página 2 · Sintetizar ──  -->
            <Grid
                Margin="20"
                IsVisible="{Binding Tab2Visible}"
                RowDefinitions="Auto,*">
                <!--  Título  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,16"
                    Spacing="2">
                    <TextBlock Classes="pageTitle" Text="Sintetizar" />
                    <TextBlock Classes="pageSub" Text="Elige la voz, escribe el texto y genera. Los textos largos se trocean y se unen solos." />
                </StackPanel>

                <!--  Contenedor  -->
                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="16">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <!--  1. Introducir texto  -->
                                <TextBlock Classes="cardTitle" Text="1 · Qué quieres decir" />
                                <TextBox
                                    Height="110"
                                    Padding="12"
                                    AcceptsReturn="True"
                                    Background="#0e1117"
                                    BorderBrush="#2a323f"
                                    FontSize="14"
                                    Foreground="#e6edf3"
                                    PlaceholderText="Escribe aquí el texto…"
                                    Text="{Binding Texto}"
                                    TextWrapping="Wrap" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#5b6675">
                                        <Run Text="{Binding Texto.Length}" />
                                        <Run Text=" caracteres" />
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#5b6675">
                                        <Run Text="Voz: " /><Run Text="{Binding VozSeleccionada.Nombre}" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="cardTitle" Text="2 · Con qué voz y cómo" />
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="VOZ" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding VocesParaElegir}"
                                            SelectedItem="{Binding VozSeleccionada}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Nombre}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="IDIOMA" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding Idiomas}"
                                            SelectedItem="{Binding IdiomaSeleccionado}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="PROCESAMIENTO" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding Dispositivos}"
                                            SelectedItem="{Binding DispositivoSeleccionado}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="MOTOR" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding Motores}"
                                            PlaceholderText="auto"
                                            SelectedItem="{Binding MotorSeleccionado}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        MaxWidth="640"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#9aa7b6"
                                        Text="{Binding InfoMotor}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Classes="ghost"
                                        Command="{Binding DescargarLlamaCommand}"
                                        Content="⬇ llama.cpp"
                                        FontSize="11" />
                                </StackPanel>
                                <Expander
                                    Background="#0e1117"
                                    BorderBrush="#2a323f"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Header="⚙ Ajustes avanzados">
                                    <StackPanel Margin="16" Spacing="10">
                                        <!--  Temperatura  -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Width="140"
                                                VerticalAlignment="Center"
                                                Classes="fieldLabel"
                                                Text="Temperatura" />
                                            <Slider
                                                Width="200"
                                                Maximum="1.5"
                                                Minimum="0.1"
                                                Value="{Binding Temperatura}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#9aa7b6"
                                                Text="{Binding Temperatura}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Classes="hint"
                                                Text="0,6 estable · 1,1 expresiva" />
                                        </StackPanel>
                                        <!--  Top-p  -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Width="140"
                                                VerticalAlignment="Center"
                                                Classes="fieldLabel"
                                                Text="Top-P" />
                                            <Slider
                                                Width="200"
                                                Maximum="1"
                                                Minimum="0.1"
                                                Value="{Binding TopP}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#9aa7b6"
                                                Text="{Binding TopP}" />

                                            <!--  Top-k  -->
                                            <TextBlock
                                                Width="60"
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Center"
                                                Classes="fieldLabel"
                                                Text="Top-K" />
                                            <TextBox
                                                Width="70"
                                                Height="26"
                                                VerticalContentAlignment="Center"
                                                Text="{Binding TopK}" />

                                            <!--  Semilla  -->
                                            <TextBlock
                                                Width="60"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Classes="fieldLabel"
                                                Text="Semilla" />
                                            <TextBox
                                                Width="70"
                                                Height="26"
                                                VerticalContentAlignment="Center"
                                                Text="{Binding Semilla}" />
                                            <TextBlock
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Classes="hint"
                                                Text="-1 = azar" />
                                        </StackPanel>

                                        <!--  Caract./Bloque  -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Width="140"
                                                VerticalAlignment="Center"
                                                Classes="fieldLabel"
                                                Text="Caract./bloque" />
                                            <TextBox Width="70" Text="{Binding CaracteresBloque}" />
                                            <!--  Pausa  -->
                                            <TextBlock
                                                Width="80"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Classes="fieldLabel"
                                                Text="Pausa (ms)" />
                                            <TextBox
                                                Width="70"
                                                Height="26"
                                                VerticalContentAlignment="Center"
                                                Text="{Binding PausaMs}" />
                                            <!--  Frames  -->
                                            <TextBlock
                                                Width="80"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Classes="fieldLabel"
                                                Text="Máx.frames" />
                                            <TextBox
                                                Width="70"
                                                Height="26"
                                                VerticalContentAlignment="Center"
                                                Text="{Binding MaxFrames}" />
                                            <!--  Hilos  -->
                                            <TextBlock
                                                Width="50"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Classes="fieldLabel"
                                                Text="Hilos" />
                                            <TextBox
                                                Width="60"
                                                Height="26"
                                                VerticalContentAlignment="Center"
                                                Text="{Binding Hilos}" />
                                            <TextBlock
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Classes="hint"
                                                Text="0 = auto" />
                                        </StackPanel>
                                        <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto">
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Classes="hint"
                                                Text="Por defecto llama.cpp: temp 0,8 · top-p 0,95 · top-k 40 · semilla -1 · 1200 frames · 280 car./bloque · pausa 150 ms · hilos 0." />
                                            <Button
                                                Grid.Column="1"
                                                Classes="ghost"
                                                Command="{Binding RestablecerAjustesCommand}"
                                                Content="↺ Restablecer valores"
                                                FontSize="11" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!--  Generar Voz  -->
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="cardTitle" Text="3 · Generar Voz" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="#9aa7b6"
                                            Text="{Binding ProgresoTexto}" />
                                        <ProgressBar
                                            Height="8"
                                            Background="#0e1117"
                                            CornerRadius="4"
                                            Maximum="100"
                                            Minimum="0"
                                            Value="{Binding ProgresoPorcentaje}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Padding="28,12"
                                        VerticalAlignment="Center"
                                        Classes="primary"
                                        Command="{Binding GenerarCommand}"
                                        Content="▶ Generar audio"
                                        FontSize="15"
                                        IsEnabled="{Binding PuedeGenerar}" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Classes="danger"
                                        Command="{Binding CancelarGeneracionCommand}"
                                        Content="Cancelar"
                                        IsVisible="{Binding MostrarCancelar}" />
                                </Grid>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#3fb950"
                                    IsVisible="{Binding !!ResultadoInfo}"
                                    Text="{Binding ResultadoInfo}"
                                    TextWrapping="Wrap" />
                                <Border
                                    Height="120"
                                    Padding="10"
                                    Background="#0e1117"
                                    BorderBrush="#2a323f"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ScrollViewer>
                                        <ItemsControl ItemsSource="{Binding Registro}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <SelectableTextBlock
                                                        FontFamily="Consolas,Menlo,monospace"
                                                        FontSize="10"
                                                        Foreground="#9aa7b6"
                                                        Text="{Binding}"
                                                        TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!--  ── Página 3 · Historial ──  -->
            <Grid
                Margin="20"
                IsVisible="{Binding Tab3Visible}"
                RowDefinitions="Auto,*">
                <Grid
                    Grid.Row="0"
                    Margin="0,0,0,16"
                    ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="pageTitle" Text="Historial" />
                        <TextBlock Classes="pageSub" Text="Todo lo generado queda aquí, con reproductor y descarga." />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#9aa7b6">
                        <Run Text="{Binding Generaciones.Count}" /><Run Text=" audios" />
                    </TextBlock>
                </Grid>
                <Border
                    Grid.Row="1"
                    Padding="12,12,12,12"
                    Classes="card">
                    <ScrollViewer>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Generaciones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="item">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Button
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Background="#4f8cff"
                                                    Classes="iconbtn"
                                                    Command="{Binding PlayHistCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="▶"
                                                    Foreground="White"
                                                    ToolTip.Tip="Escuchar" />
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                                    <TextBlock
                                                        FontSize="13"
                                                        Foreground="White"
                                                        Text="{Binding Texto}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11" Foreground="#9aa7b6">
                                                        <Run Text="{Binding FechaFormateada}" /><Run Text=" · " /><Run Text="{Binding Duracion}" /><Run Text=" s" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <Button
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Background="#1e2530"
                                                        BorderBrush="#2a323f"
                                                        BorderThickness="1"
                                                        Classes="iconbtn"
                                                        Command="{Binding DescargarCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="⬇"
                                                        Foreground="#e6edf3"
                                                        ToolTip.Tip="Descargar al escritorio" />
                                                    <Button
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Background="#1e2530"
                                                        BorderBrush="#2a323f"
                                                        BorderThickness="1"
                                                        Classes="iconbtn"
                                                        Command="{Binding SaveVozCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="＋"
                                                        Foreground="#3fb950"
                                                        ToolTip.Tip="Guardar en Voces para reutilizarla" />
                                                    <Button
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Classes="dangerGhost"
                                                        Command="{Binding DeleteHistCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="✕"
                                                        ToolTip.Tip="Borrar" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                Classes="empty"
                                IsVisible="{Binding !HayHistorial}"
                                Text="Aún no hay audios.&#10;Ve a Sintetizar y pulsa «Generar audio» →" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!--  ── Página 4 · Modelos ──  -->
            <Grid
                Margin="20"
                IsVisible="{Binding Tab4Visible}"
                RowDefinitions="Auto,*">
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,16"
                    Spacing="2">
                    <TextBlock Classes="pageTitle" Text="Modelos" />
                    <TextBlock Classes="pageSub" Text="Descarga los pesos GGUF una sola vez; después todo funciona sin conexión." />
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="16">
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="cardTitle" Text="Estado" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#e6edf3"
                                    Text="{Binding ModeloEstado}"
                                    TextWrapping="Wrap" />
                                <TextBlock Classes="hint" Text="Hacen falta DOS archivos: el modelo principal y su mmproj (vocoder). Sin ambos no hay síntesis con el motor llama." />
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="cardTitle" Text="Descargar pesos" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="MODELO PRINCIPAL" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding ModeloOpciones}"
                                            SelectedItem="{Binding ModeloSeleccionado}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Etiqueta}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="fieldLabel" Text="VOCODER (MMPROJ)" />
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding MmprojOpciones}"
                                            SelectedItem="{Binding MmprojSeleccionado}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Etiqueta}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#9aa7b6"
                                            Text="{Binding ModeloProgresoTexto}"
                                            TextWrapping="Wrap" />
                                        <ProgressBar
                                            Height="8"
                                            Background="#0e1117"
                                            CornerRadius="4"
                                            Maximum="100"
                                            Minimum="0"
                                            Value="{Binding ModeloProgreso}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Classes="primary"
                                        Command="{Binding DescargarModeloCommand}"
                                        Content="⬇ Descargar"
                                        IsEnabled="{Binding !DescargandoModelo}" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Classes="danger"
                                        Command="{Binding CancelarDescargaModeloCommand}"
                                        Content="Cancelar"
                                        IsVisible="{Binding DescargandoModelo}" />
                                </Grid>
                                <Border
                                    Padding="10"
                                    Background="#0e1117"
                                    BorderBrush="#2a323f"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <TextBlock Classes="hint" Text="💡 ~1,5 GB en total con los valores por defecto. La descarga es reanudable y verifica el SHA-256 al terminar, igual que en Clonar-voz." />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
